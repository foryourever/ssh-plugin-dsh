{
  "name": "@local/dsh-plugin-ssh",
  "version": "1.0.6",
  "description": "DeepSeek Harness SSH terminal, SFTP and agent tools, adapted from dbx-plugin-ssh.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "bin/dbx-plugin-ssh*",
    "original",
    "scripts",
    "upstream-release-lock.json",
    "UPSTREAM.json",
    "tools.snapshot.json",
    "THIRD_PARTY_NPM.json",
    "frontend/src",
    "frontend/shared",
    "frontend/vendor",
    "frontend/package.json",
    "frontend/package-lock.json",
    "frontend/tsconfig.json",
    "frontend/vite.config.ts",
    "frontend/build.mjs",
    "frontend/index.html",
    "frontend/components.json",
    "tests",
    "package-lock.json",
    "README.md",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "setup:backend": "node scripts/setup-backend.mjs",
    "build": "node scripts/build-client.mjs",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "pack:bundle": "python3 scripts/package.py",
    "check": "node --check index.js && node --check src/service.js && npm test && npm run verify:upstream",
    "check:harness": "node scripts/verify-harness-host.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "ssh2": "1.17.0"
  },
  "engines": {
    "node": ">=22"
  }
}
